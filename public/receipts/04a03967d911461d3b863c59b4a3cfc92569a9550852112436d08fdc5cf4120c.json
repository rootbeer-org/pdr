          "-DUSE_APPLE_SECTRUST=ON",
          "-DCURL_CA_FALLBACK=ON",
          "-DCURL_BUILD_EVERYTHING=ON"
        ]
      ],
      "build": [
        [
          "cmake",
          "--build",
          "build",
          "--parallel",
          "{jobs}"
        ]
      ],
