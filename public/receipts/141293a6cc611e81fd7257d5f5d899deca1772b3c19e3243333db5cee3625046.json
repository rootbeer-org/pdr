          "--build",
          "build",
          "--target",
          "test-nonflaky",
          "--parallel",
          "{jobs}"
        ],
        [
          "/bin/sh",
          "-ec",
          "features=$(build/src/curl --version); for feature in HTTP2 HTTP3 SSL brotli zstd IDN PSL sftp https; do case \"$features\" in *\"$feature\"*) ;; *) echo \"missing curl feature: $feature\" >&2; exit 1;; esac; done"
