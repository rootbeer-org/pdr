{"record":{"schema":2,"system":"x86_64-linux","revision":1,"recipe":{"build":{"backend":"custom","url":"https://download.samba.org/pub/rsync/src/rsync-3.5.1.tar.gz","sha256":"c55f9c9dc10fb8bec397b399a0fdded53cc9a2d8e30891bb0d63724d25c37bef","archive":"tar.gz","strip_prefix":"rsync-3.5.1","configure":[],"patches":["--- a/testsuite/chmod-setid_test.py\n+++ b/testsuite/chmod-setid_test.py\n@@ -8,6 +8,9 @@\n from rsyncfns import SCRATCHDIR, run_rsync, test_fail\n \n base = SCRATCHDIR / 'chmod_setid'\n+base.mkdir(parents=True, exist_ok=True)\n+# macOS clears setgid when the inherited directory group is not ours.\n+os.chown(base, -1, os.getgid())\n src = base / 'src'\n dst = base / 'dst'\n src.mkdir(parents=True, exist_ok=True)\n","--- a/testsuite/install-strip_test.py\n+++ b/testsuite/install-strip_test.py\n@@ -91,7 +91,8 @@\n         test_fail(f'install-strip did not install {installed}')\n     if not strip_log.is_file():\n         test_fail(f'install-strip did not call {strip_name}')\n-    if strip_log.read_text().splitlines() != [str(installed)]:\n+    # A prefix of / makes the Makefile pass //bin/rsync, the same file.\n+    if [os.path.normpath(line) for line in strip_log.read_text().splitlines()] != [str(installed)]:\n         test_fail(f'{strip_name} was not called with {installed}')\n     if not filecmp.cmp(source_rsync, installed, shallow=False):\n         test_fail(f'{strip_name} unexpectedly changed the installed test binary')\n"],"dependencies":["openssl@4.0.2","xxhash@0.8.3","zstd@1.5.7","lz4@1.10.0","zlib@1.3.2","libidn2@2.3.8"],"steps":{"configure":[["sh","./configure","--prefix=/","--disable-debug","--disable-md2man","LIBS=-lunistring -liconv"]],"build":[["make","-j{jobs}"]],"check":[["make","check"],["/bin/sh","-ec","PATH=\"$PWD:$PATH\"; export PATH; directory=$(mktemp -d); trap 'rm -rf \"$directory\"' EXIT; mkdir \"$directory/source\" \"$directory/destination\"; printf rootbeer-rsync > \"$directory/source/file\"; rsync -a --checksum \"$directory/source/\