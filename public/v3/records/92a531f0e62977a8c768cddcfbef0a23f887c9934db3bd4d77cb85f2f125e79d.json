{"record":{"schema":2,"system":"aarch64-linux","revision":1,"recipe":{"build":{"backend":"custom","url":"https://download.samba.org/pub/rsync/src/rsync-3.5.1.tar.gz","sha256":"c55f9c9dc10fb8bec397b399a0fdded53cc9a2d8e30891bb0d63724d25c37bef","archive":"tar.gz","strip_prefix":"rsync-3.5.1","configure":[],"patches":["--- a/testsuite/chmod-setid_test.py\n+++ b/testsuite/chmod-setid_test.py\n@@ -8,6 +8,9 @@\n from rsyncfns import SCRATCHDIR, run_rsync, test_fail\n \n base = SCRATCHDIR / 'chmod_setid'\n+base.mkdir(parents=True, exist_ok=True)\n+# macOS clears setgid when the inherited directory group is not ours.\n+os.chown(base, -1, os.getgid())\n src = base / 'src'\n dst = base / 'dst'\n src.mkdir(parents=True, exist_ok=True)\n","--- a/testsuite/install-strip_test.py\n+++ b/testsuite/install-strip_test.py\n@@ -91,7 +91,8 @@\n         test_fail(f'install-strip did not install {installed}')\n     if not strip_log.is_file():\n         test_fail(f'install-strip did not call {strip_name}')\n-    if strip_log.read_text().splitlines() != [str(installed)]:\n+    # A prefix of / makes the Makefile pass //bin/rsync, the same file.\n+    if [os.path.normpath(line) for line in strip_log.read_text().splitlines()] != [str(installed)]:\n         test_fail(f'{strip_name} was not called with {installed}')\n     if not filecmp.cmp(source_rsync, installed, shallow=False):\n         test_fail(f'{strip_name} unexpectedly changed the installed test binary')\n"],"dependencies":["openssl@4.0.2","xxhash@0.8.3","zstd@1.5.7","lz4@1.10.0","zlib@1.3.2","libidn2@2.3.8"],"steps":{"configure":[["sh","./configure","--prefix=/","--disable-debug","--disable-md2man","LIBS=-lunistring -liconv"]],"build":[["make","-j{jobs}"]],"check":[["make","check"],["/bin/sh","-ec","PATH=\"$PWD:$PATH\"; export PATH; directory=$(mktemp -d); trap 'rm -rf \"$directory\"' EXIT; mkdir \"$directory/source\" \"$directory/destination\"; printf rootbeer-rsync > \"$directory/source/file\"; rsync -a --checksum \"$directory/source/\" \"$directory/destination/\"; cmp \"$directory/source/file\" \"$directory/destination/file\"; rm \"$directory/source/file\"; rsync -a --delete \"$directory/source/\" \"$directory/destination/\"; test ! -e \"$directory/destination/file\""]],"install":[["make","DESTDIR={prefix}","install"]]}},"bins":["rsync"],"checks":[["rsync","--version"]]},"artifact":{"revision":1,"receipt_sha256":"c2d7ea51973d729e800d8818b45f1a7f9f037515d7c60804d444bb8da8772008","package":{"name":"rsync","version":"3.5.1","source":{"Url":{"url":"ghcr://rootbeer-org/pdr/rsync@sha256:1aaab7560b0222e2be0df2a69b0b00ae47fdc3f83e89c2a6ce52dcfbe0d25325","sha256":"1aaab7560b0222e2be0df2a69b0b00ae47fdc3f83e89c2a6ce52dcfbe0d25325"}},"install":{"Archive":{"format":"TarGz","strip_prefix":null}},"provides":{"bins":{"rsync":"bin/rsync"}},"output_sha256":"63add69f37b755dfd47f7f5b3c3bdad321412d238512f01750ab70d8d057a166"}},"provenance":{"engine_sha256":"aae915b37fa27deeb948c7febbcac1f294a22da5e5f4b39d8f142479810bc62b","environment_sha256":"2b2fdd27966897c3ada494ebf4974311b076d41647287c4df74421f8b95cf501","environment":{"schema":1,"system":"aarch64-linux","tools":{"ar":{"path":"/usr/bin/ar","sha256":"f4583a612510e038dbc1ae8afb5eae5f0445c435bdd7c4c28e78acc7e757d2b1"},"c++":{"path":"/usr/bin/c++","sha256":"fc02363794280f404c6ca6f5da1c8fe469be902e9de140d35d8573bb3393f53b"},"cc":{"path":"/usr/bin/cc","sha256":"a20520ee21543f243d40636a9181a142c45ecd989de31ab86b99a8ea5ada870d"},"make":{"path":"/usr/bin/make","sha256":"abbecc214fcadef6530d1cc137bde7ceb74cae3f6b992c7d10a8669a7314c7e0"},"patch":{"path":"/usr/bin/patch","sha256":"1b04b2a8dffbcfa9d75d17eb386a73f271415142d4e48baab2acfc10b1cca8f5"},"ranlib":{"path":"/usr/bin/ranlib","sha256":"824de22ce448c3567e631425f7754a6df72e90bd758079daa94f1aa6edf41513"},"sh":{"path":"/usr/bin/sh","sha256":"c883d9c27228339580994a1d0ea960645368c7d1b960a712bd0c655860c2d0d7"},"uname":{"path":"/usr/bin/uname","sha256":"3546dcb97c9bf54b891d85c64fb876584e2cb9b589c6efcab4a45f3b0a8994ac"}},"inpu