{"record":{"schema":2,"system":"aarch64-linux","revision":3,"recipe":{"build":{"backend":"custom","url":"https://download.samba.org/pub/rsync/src/rsync-3.5.0.tar.gz","sha256":"c7ffd1ef653e99540f661e47cb00b7f9cad1ee6b972399b16f93d672656e0d33","archive":"tar.gz","strip_prefix":"rsync-3.5.0","configure":[],"patches":["--- a/testsuite/chmod-setid_test.py\n+++ b/testsuite/chmod-setid_test.py\n@@ -8,6 +8,9 @@\n from rsyncfns import SCRATCHDIR, run_rsync, test_fail\n \n base = SCRATCHDIR / 'chmod_setid'\n+base.mkdir(parents=True, exist_ok=True)\n+# macOS clears setgid when the inherited directory group is not ours.\n+os.chown(base, -1, os.getgid())\n src = base / 'src'\n dst = base / 'dst'\n src.mkdir(parents=True, exist_ok=True)\n","--- a/testsuite/protected-regular_test.py\n+++ b/testsuite/protected-regular_test.py\n@@ -49,11 +49,17 @@\n     if not os.environ.get('RSYNC_UNSHARED'):\n         unshare = shutil.which('unshare')\n         if unshare is not None:\n-            probe = subprocess.run(\n-                [unshare, '--user', '--map-root-user',\n-                 '--map-users', '5001:100000:1', 'true'],\n-                capture_output=True,\n-            )\n+            try:\n+                probe = subprocess.run(\n+                    [unshare, '--user', '--map-root-user',\n+                     '--map-users', '5001:100000:1', 'true'],\n+                    stdin=subprocess.DEVNULL,\n+                    stdout=subprocess.DEVNULL,\n+                    stderr=subprocess.DEVNULL,\n+                    timeout=5,\n+                )\n+            except subprocess.TimeoutExpired:\n+                test_skipped(\"Can't chown (unshare probe timed out)\")\n             if probe.returncode == 0:\n                 print(\"Re-running under unshare with UID mapping...\")\n                 env = os.environ.copy()\n"],"dependencies":[{"package":"openssl@4.0.2","kind":"link_runtime"},"xxhash@0.8.3",{"package":"zstd@1.5.7","kind":"link_runtime"},{"package":"lz4@1.10.0","ki