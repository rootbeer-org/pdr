{"record":{"schema":2,"system":"aarch64-macos","revision":1,"recipe":{"build":{"backend":"custom","url":"https://download.samba.org/pub/rsync/src/rsync-3.5.1.tar.gz","sha256":"c55f9c9dc10fb8bec397b399a0fdded53cc9a2d8e30891bb0d63724d25c37bef","archive":"tar.gz","strip_prefix":"rsync-3.5.1","configure":[],"patches":["--- a/testsuite/chmod-setid_test.py\n+++ b/testsuite/chmod-setid_test.py\n@@ -8,6 +8,9 @@\n from rsyncfns import SCRATCHDIR, run_rsync, test_fail\n \n base = SCRATCHDIR / 'chmod_setid'\n+base.mkdir(parents=True, exist_ok=True)\n+# macOS clears setgid when the inherited directory group is not ours.\n+os.chown(base, -1, os.getgid())\n src = base / 'src'\n dst = base / 'dst'\n src.mkdir(parents=True, exist_ok=True)\n","--- a/testsuite/install-strip_test.py\n+++ b/testsuite/install-strip_test.py\n@@ -91,7 +91,8 @@\n         test_fail(f'install-strip did not install {installed}')\n     if not strip_log.is_file():\n         test_fail(f'install-strip did not call {strip_name}')\n-    if strip_log.read_text().splitlines() != [str(installed)]:\n+    # A prefix of / makes the Makefile pass //bin/rsync, the same file.\n+    if [os.path.normpath(line) for line in strip_log.read_text().splitlines()] != [str(installed)]:\n         test_fail(f'{strip_name} was not called with {installed}')\n     if not filecmp.cmp(source_rsync, installed, shallow=False):\n         test_fail(f'{strip_name} unexpectedly changed the installed test binary')\n"],"dependencies":["openssl@4.0.2","xxhash@0.8.3","zstd@1.5.7","lz4@1.10.0","zlib@1.3.2","libidn2@2.3.8"],"steps":{"configure":[["sh","./configure","--prefix=/","--disable-debug","--disable-md2man","LIBS=-lunistring -liconv"]],"build":[["make","-j{jobs}"]],"check":[["make","check"],["/bin/sh","-ec","PATH=\"$PWD:$PATH\"; export PATH; directory=$(mktemp -d); trap 'rm -rf \"$directory\"' EXIT; mkdir \"$directory/source\" \"$directory/destination\"; printf rootbeer-rsync > \"$directory/source/file\"; rsync -a --checksum \"$directory/source/\" \"$directory/destination/\"; cmp \"$directory/source/file\" \"$directory/destination/file\"; rm \"$directory/source/file\"; rsync -a --delete \"$directory/source/\" \"$directory/destination/\"; test ! -e \"$directory/destination/file\""]],"install":[["make","DESTDIR={prefix}","install"]]}},"bins":["rsync"],"checks":[["rsync","--version"]]},"artifact":{"revision":1,"receipt_sha256":"add122837eb9536e5a81cd3b78af7ec277bd51cff88d7d1f22466d1f29798904","package":{"name":"rsync","version":"3.5.1","source":{"Url":{"url":"ghcr://rootbeer-org/pdr/rsync@sha256:c974760486debd50111a35709a2f72abcca5aaf5f61fc2172ff648bbca7485af","sha256":"c974760486debd50111a35709a2f72abcca5aaf5f61fc2172ff648bbca7485af"}},"install":{"Archive":{"format":"TarGz","strip_prefix":null}},"provides":{"bins":{"rsync":"bin/rsync"}},"output_sha256":"72f9d4252a1ae0490f722a294f19a1c4544801dca1d3a9707d9b43172fc69819"}},"provenance":{"engine_sha256":"aae915b37fa27deeb948c7febbcac1f294a22da5e5f4b39d8f142479810bc62b","environment_sha256":"033c3ffba5fb703ee400d4c8ad2f5d60177e7ae628f096a88b9c108ce8e47fcc","environment":{"schema":1,"system":"aarch64-macos","tools":{"ar":{"path":"/usr/bin/ar","sha256":"7f30f076d0e9c38f772a76449fca9da8cf97f6a3d43b94c90a00e4f9ce7ad39e"},"c++":{"path":"/usr/bin/c++","sha256":"7f30f076d0e9c38f772a76449fca9da8cf97f6a3d43b94c90a00e4f9ce7ad39e"},"cc":{"path":"/usr/bin/cc","sha256":"7f30f076d0e9c38f772a76449fca9da8cf97f6a3d43b94c90a00e4f9ce7ad39e"},"make":{"path":"/usr/bin/make","sha256":"7f30f076d0e9c38f772a76449fca9da8cf97f6a3d43b94c90a00e4f9ce7ad39e"},"patch":{"path":"/usr/bin/patch","sha256":"5f1577051f23e9a4232aa8d763bd1ed51b788815b28e3f90dd453ec459f2795d"},"ranlib":{"path":"/usr/bin/ranlib","sha256":"7f30f076d0e9c38f772a76449fca9da8cf97f6a3d43b94c90a00e4f9ce7ad39e"},"sh":{"path":"/bin/sh","sha256":"fcde7861d5e4f86f3a90d4fc3132f8712cf139f9fda52a59361d35007b605d61"},"uname":{"path":"/usr/bin/uname","sha256":"6900a4b92282ed31bab441b8569ab5c7dd230051e0c290c4cb3506f00ba843d9"}},"inputs":